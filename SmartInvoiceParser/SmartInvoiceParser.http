@SmartInvoiceParser_HostAddress = https://localhost:7296

### 1. إضافة فاتورة جديدة (POST)
POST {{SmartInvoiceParser_HostAddress}}/api/invoices
Content-Type: application/json

{
  "vendorName": "Tech Store",
  "invoiceNumber": "INV-1001",
  "invoiceDate": "2026-11-19T00:00:00",
  "subTotal": 1000,
  "taxAmount": 140,
  "totalAmount": 1140,
  "items": [
    {
      "description": "Laptop Stand",
      "quantity": 2,
      "unitPrice": 500,
      "totalPrice": 1000
    }
  ]
}

### 2. عرض كل الفواتير (GET)
GET {{SmartInvoiceParser_HostAddress}}/api/invoices
Accept: application/json

### 3. عرض فاتورة واحدة برقمها (GET by ID)
GET {{SmartInvoiceParser_HostAddress}}/api/invoices/1
Accept: application/json

### 4. حذف فاتورة برقمها (DELETE)
DELETE {{SmartInvoiceParser_HostAddress}}/api/invoices/1

### 5. تعديل فاتورة موجودة (PUT)
PUT {{SmartInvoiceParser_HostAddress}}/api/invoices/2
Content-Type: application/json

{
  "id": 2,
  "vendorName": "Tech Store Updated",
  "invoiceNumber": "INV-1001",
  "invoiceDate": "2026-11-19T00:00:00",
  "subTotal": 1500,
  "taxAmount": 210,
  "totalAmount": 1710,
  "filePath": "",
  "items": [
    {
      "description": "Laptop Stand Pro",
      "quantity": 3,
      "unitPrice": 500,
      "totalPrice": 1500
    }
  ]
}